# 서버
PORT=4000
CORS_ORIGIN=http://localhost:5173

# 카카오 로컬 API (주소/장소 검색) - https://developers.kakao.com 에서 REST API 키 발급
KAKAO_REST_API_KEY=

# ODsay 대중교통 길찾기 API - https://lab.odsay.com 에서 앱키 발급
ODSAY_API_KEY=

# 서울 열린데이터광장(data.seoul.go.kr) 인증키 - 지하철 역명검색 (역명->외부코드)
SEOUL_SUBWAY_STATION_API_KEY=

# 공공데이터포털(data.go.kr) - 서울특별시_정류소정보조회 서비스 (data.go.kr/data/15000303)
BUS_STATION_INFO_API_KEY=

# 국토교통부 TAGO 지하철정보 (data.go.kr/data/15098554) - 역별시간표 목록 조회
TAGO_SUBWAY_API_KEY=

# 국토교통부 TAGO 버스노선정보 (data.go.kr/data/15098529) - 노선별 첫차/막차시간
TAGO_BUS_ROUTE_API_KEY=

# Web Push (VAPID) - `npm run generate-vapid`로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com
