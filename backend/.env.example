# 서버
PORT=4000
CORS_ORIGIN=http://localhost:5173

# 카카오 로컬 API (주소/장소 검색) - https://developers.kakao.com 에서 REST API 키 발급
KAKAO_REST_API_KEY=

# ODsay 대중교통 길찾기 API - https://lab.odsay.com 에서 앱키 발급
ODSAY_API_KEY=

# 공공데이터포털(data.go.kr) - 서울특별시_정류소정보조회 서비스 (data.go.kr/data/15000303)
# getBustimeByStation(정류장+노선 기준 버스 막차) 조회에 사용
BUS_STATION_INFO_API_KEY=

# Web Push (VAPID) - `npm run generate-vapid`로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com
