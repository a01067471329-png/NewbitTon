# 서버
PORT=4000
# 콤마로 여러 origin을 나열 가능 (예: 로컬 개발 + 배포된 프론트 주소를 동시에 허용)
CORS_ORIGIN=http://localhost:5173

# 경로탐색 제공자: odsay(기본값) | kakao. kakao로 바꾸면 dapi.kakao.com/v2/routing/publictraffic로
# 경로를 탐색하고, ODsay/TOPIS는 그 결과의 역/정류장 이름을 ID로 역변환하는 데만 쓰인다
# (routes.js, services/providers/kakao.js 참고). 문제가 생기면 이 값만 지우면 즉시 롤백된다.
ROUTING_PROVIDER=odsay

# 카카오 로컬 API (주소/장소 검색 + 대중교통 경로 조회) - https://developers.kakao.com 에서 REST API 키 발급
KAKAO_REST_API_KEY=

# ODsay 대중교통 길찾기 API - https://lab.odsay.com 에서 앱키 발급
# ROUTING_PROVIDER=kakao일 때도 지하철 역명->ID 변환(searchStation)과 막차시간표 조회에 계속 사용됨
ODSAY_API_KEY=

# 공공데이터포털(data.go.kr) - 서울특별시_정류소정보조회 서비스 (data.go.kr/data/15000303)
# getBustimeByStation(정류장+노선 기준 버스 막차), getStationByPos/getRouteByStation(F6 심야버스) 조회에 사용
BUS_STATION_INFO_API_KEY=

# 서울 열린데이터광장(data.seoul.go.kr) - 계정당 공통 인증키
# 1~9호선 지하철 열차시간표/막차 조회(OA-101, OA-108, OA-110)에 사용 예정
SEOUL_OPENDATA_API_KEY=

# Web Push (VAPID) - `npm run generate-vapid`로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# Push 알림의 image(안드로이드 큰 이미지 배너)·icon(iOS 포함 공통 작은 아이콘)
# 절대 URL을 만들 때 쓰는 베이스.
# 비워두면 배포된 Render 주소(https://newbitton.onrender.com)를 기본값으로 사용한다.
PUBLIC_BASE_URL=
