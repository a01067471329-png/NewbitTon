# 백엔드 API 베이스 URL (로컬 개발 시 backend/README.md 기준 기본 포트 4000)
VITE_API_BASE_URL=http://localhost:4000

# true로 두면 백엔드 서버 없이 프론트엔드 내장 mock 데이터로 동작 (오프라인 개발용)
# false 또는 비워두면 VITE_API_BASE_URL로 실제 요청을 보냄 (백엔드가 꺼져 있어도
# 백엔드 자체 mock 로직이 응답하므로 npm run dev로 백엔드만 띄워도 정상 동작)
VITE_USE_MOCK=false

# 카카오맵 JavaScript SDK 앱키 (F2 경로 선택 화면 지도용, https://developers.kakao.com
# > 내 애플리케이션 > JavaScript 키). 서버 프록시 없이 브라우저에서 직접 로드하는
# 키라 REST API 키와는 다르다 (docs/PRD_Newbiton.md 1.6 참고).
# 비워두면 지도 대신 안내 문구가 표시되고, 나머지 화면은 정상 동작한다.
VITE_KAKAO_MAP_APP_KEY=
